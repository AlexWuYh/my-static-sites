#!/bin/bash
# 提交前自动同步：
#  - 中文页变更 → 重新生成对应的英文页
#  - 中文页或 products.json 变更 → 同步各页面底部的友情链接
staged=$(git diff --cached --name-only)
touched=0
before=$(git diff --name-only | sort)

if echo "$staged" | grep -qx 'ScreenClock/index.html'; then
  python3 scripts/screenclock_gen_en.py || exit 1
  touched=1
fi
if echo "$staged" | grep -qx 'DicomFLow-App/index.html'; then
  python3 scripts/dicomflow_gen_en.py || exit 1
  touched=1
fi
if echo "$staged" | grep -qx 'Jot/index.html'; then
  python3 scripts/jot_gen_en.py || exit 1
  touched=1
fi
if echo "$staged" | grep -qx 'products.json'; then
  python3 scripts/sync_friend_links.py >/dev/null || exit 1
  touched=1
fi

if [ "$touched" = 1 ]; then
  after=$(git diff --name-only | sort)
  # 只暂存本钩子新产生的改动，不碰你其他未暂存的修改
  for f in $(comm -13 <(echo "$before") <(echo "$after") 2>/dev/null); do
    git add "$f"
    echo "pre-commit: 已同步并暂存 $f"
  done
fi
